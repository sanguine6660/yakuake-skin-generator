{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Yakuake Skin Generator",
    "version": "1.0.0",
    "identifier": "com.sanguine6660.yakuake-skin-generator",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:4000",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Yakuake Skin Generator",
                "width": 1280,
                "height": 820,
                "minWidth": 900,
                "minHeight": 620,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
