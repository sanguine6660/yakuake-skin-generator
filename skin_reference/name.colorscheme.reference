[General]
# The descriptive name of the color scheme shown in the Konsole/Yakuake settings menu
Description=My Custom Theme

# Opacity level of the terminal background (ranges from 0.0 = fully transparent to 1.0 = fully opaque)
Opacity=1.0

# Optional path to a background wallpaper image for the terminal area
# Wallpaper=background.png


# --- COLOR PALETTE DEFINITION ---
# Konsole uses numbered color slots split into Normal and Intensive (Bold) sets, 
# plus general background and foreground definitions.
# Each entry uses Red, Green, Blue (RGB) values separated by commas (0-255).

[Background]
# The primary background color of the terminal text area
Color=30,30,30

[BackgroundIntense]
# The background color used when intense/bold background styling is triggered
Color=50,50,50

[Foreground]
# The primary text (foreground) color of the terminal
Color=220,220,220

[ForegroundIntense]
# The text color used when intense/bold text styling is triggered
Color=255,255,255


# --- NORMAL COLORS (Standard ANSI Palette 0-7) ---

[Color0]
# Normal Black
Color=40,40,40

[Color1]
# Normal Red
Color=204,54,54

[Color2]
# Normal Green
Color=78,154,6

[Color3]
# Normal Yellow/Brown
Color=196,160,0

[Color4]
# Normal Blue
Color=52,101,164

[Color5]
# Normal Magenta/Purple
Color=117,80,123

[Color6]
# Normal Cyan
Color=6,152,154

[Color7]
# Normal White/Light Gray
Color=211,215,207


# --- INTENSE / BOLD COLORS (Bright ANSI Palette 8-15) ---

[Color0Intense]
# Intense/Bright Black (often used for dark gray / comments)
Color=85,87,83

[Color1Intense]
# Intense/Bright Red
Color=239,41,41

[Color2Intense]
# Intense/Bright Green
Color=138,226,52

[Color3Intense]
# Intense/Bright Yellow
Color=252,233,79

[Color4Intense]
# Intense/Bright Blue
Color=114,159,207

[Color5Intense]
# Intense/Bright Magenta
Color=173,127,168

[Color6Intense]
# Intense/Bright Cyan
Color=52,226,226

[Color7Intense]
# Intense/Bright White
Color=238,238,236
