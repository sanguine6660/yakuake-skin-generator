[Description]
Skin=MyCustomSkin
Author=John Doe
Email=john.doe@example.com
Icon=icon.png

[Background]
# Main background image spanning across the entire tab bar layout
back_image=tabs_background.png

# Left corner image for the tab bar container
left_corner=tabs_left_corner.png

# Right corner image for the tab bar container
right_corner=tabs_right_corner.png

[Tab]
# Component graphics for an unselected (inactive) tab item
unselected_left=tab_unselected_left.png
unselected_middle=tab_unselected_middle.png
unselected_right=tab_unselected_right.png

# Component graphics for the selected (active) tab item
selected_left=tab_selected_left.png
selected_middle=tab_selected_middle.png
selected_right=tab_selected_right.png

# Vertical separator image placed between individual tabs
separator=tab_separator.png

[Text]
# Horizontal offset of the tab title string inside the tab body
x=10

# Vertical offset of the tab title string inside the tab body
y=3

# RGB text color applied to the active/selected tab title
selected_color=255,255,255

# RGB text color applied to inactive/unselected tab titles
unselected_color=150,150,150

[CloseButton]
# X coordinate for an optional close button rendered directly inside a tab
x=5

# Y coordinate for an optional close button rendered directly inside a tab
y=5

# Normal image state for the individual tab close button
up_image=tab_close_up.png

# Hover image state for the individual tab close button
over_image=tab_close_over.png

# Clicked image state for the individual tab close button
down_image=tab_close_down.png

[LockButton]
# Image icon displayed on a tab when it is locked to prevent accidental closure
prevent_closing_image=tab_locked.png

# X coordinate position for the lock indicator icon
x=5

# Y coordinate position for the lock indicator icon
y=5
