# title.skin — Reference
# Verified against Yakuake source: app/skin.cpp (parsing) and app/titlebar.cpp (rendering)
# https://invent.kde.org/utilities/yakuake
# NOTE: inline comments are for documentation only — remove them before using
#       this file as an actual skin (KConfig does not support inline comments).

[Description]                                          # section: skin metadata (required)
Skin=MyCustomSkin                                      # name shown in Yakuake's skin selector
Author=John Doe                                        # author name
Email=john.doe@example.com                             # author email
Web=https://example.com                                # optional: author website
Icon=/logo.svg                                         # skin icon, path relative to the skin folder

[Background]                                           # section: title bar background
back_image=/title/back_image.svg                       # bar background — TILED horizontally between the corners; its IMAGE HEIGHT sets the title bar height
left_corner=/title/left_corner.svg                     # left window corner piece (natural size; its alpha channel shapes the window mask)
right_corner=/title/right_corner.svg                   # right window corner piece

[Border]                                               # section: window border around the terminal
width=0                                                # border thickness in px, 0 = none (default: 1)
red=0                                                  # border color, red component (0-255)
green=0                                                # border color, green component
blue=0                                                 # border color, blue component

[Text]                                                 # section: title bar text
text=MyCustomSkin                                      # static text appended to the session title as "<session> - <text>"
x=14                                                   # text x position inside the bar
y=18                                                   # text y position inside the bar
red=255                                                # text color, red component (0-255)
green=255                                              # text color, green component
blue=255                                               # text color, blue component
bold=true                                              # bold text (default: true)
centered=false                                         # optional: center text horizontally when it fits (default: false)

[FocusButton]                                          # section: "keep window open" toggle (rendered as QPushButton at natural image size)
x=88                                                   # button x position, measured from the anchor side (default anchor: right)
y=4                                                    # button y position
anchor=right                                           # anchor side for x: left or right (default: right)
up_image=/title/focus_up.svg                           # normal state image
over_image=/title/focus_over.svg                       # hover state image
down_image=/title/focus_down.svg                       # pressed state image

[ConfigButton]                                         # section: menu button (same rendering rules as FocusButton)
x=58                                                   # button x position from the anchor side
y=4                                                    # button y position
anchor=right                                           # anchor side for x
up_image=/title/config_up.svg                          # normal state image
over_image=/title/config_over.svg                      # hover state image
down_image=/title/config_down.svg                      # pressed state image

[QuitButton]                                           # section: quit button (same rendering rules as FocusButton)
x=28                                                   # button x position from the anchor side
y=4                                                    # button y position
anchor=right                                           # anchor side for x
up_image=/title/quit_up.svg                            # normal state image
over_image=/title/quit_over.svg                        # hover state image
down_image=/title/quit_down.svg                        # pressed state image
